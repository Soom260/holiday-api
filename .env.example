# 로컬 시험 서버(scripts/dev.mjs)에서 실제 공공데이터를 부를 때만 씁니다.
# 이 파일을 복사해 이름을 .env.local로 바꾸고, = 뒤에 일반 인증키(Decoding)를 붙여 넣습니다.
# .env.local은 .gitignore에 있어 저장소에 올라가지 않습니다.
DATA_GO_KR_KEY=

# 한 줄 방명록(api/guestbook.js) · Supabase 대시보드 → Project Settings → Data API / API Keys
# SECRET 키는 서버 전용입니다. 화면 코드·저장소·채팅에 붙여 넣지 않습니다.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
